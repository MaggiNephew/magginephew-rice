#  run a tool: normal shell, or a throwaway firejail sandbox (optionally offline)
# ----------------------------------------------------------------------------
def shell_argv(cmd, mode="plain"):
    """argv for an interactive shell ready to run `cmd`.
    mode: "plain" (your normal shell) | "sandbox" (empty throwaway home, no privileges)
          | "offline" (sandbox + no network). Raises RuntimeError if firejail is missing."""
    lines = [f"\u2500\u2500 {cmd} \u2500\u2500"]
    if mode == "plain":
        lines.append(f"try:  {cmd} --help")
        ps1 = None
    else:
        if not shutil.which("firejail"):
            raise RuntimeError("firejail is not installed \u2014 sudo pacman -S firejail "
                               "(or run: sudo rice-system-setup)")
        lines += ["SANDBOX: empty throwaway home (your files are not visible), no root, no new privileges",
                  "         everything written here is deleted when this window closes",
                  "OFFLINE: no network access at all" if mode == "offline" else "network: on",
                  "tools that need root / raw sockets (nmap -sS, aircrack, \u2026) will not work here",
                  f"try:  {cmd} --help"]
        ps1 = "[sandbox" + (" offline" if mode == "offline" else "") + "] \\W \\$ "
    banner = "; ".join(f"printf '%s\\n' {shlex.quote(l)}" for l in lines)
    if ps1 is None:
        inner = ["bash", "-c", banner + "; exec bash -i"]
        return inner
    inner = ["bash", "-c", banner + f"; exec env PS1={shlex.quote(ps1)} bash --norc --noprofile -i"]
    fj = ["firejail", "--quiet", "--private", "--private-tmp", "--nonewprivs", "--caps.drop=all",
          "--noroot", "--hostname=sandbox", f"--name=cyber-{re.sub(r'[^A-Za-z0-9_-]', '_', cmd)}"]
    if mode == "offline":
        fj.append("--net=none")
    return fj + inner


def launch_window(cmd, mode="plain"):
    """Open the shell from shell_argv() in a new kitty window."""
    argv = shell_argv(cmd, mode)
    term = shutil.which("kitty")
    if not term:
        raise RuntimeError("kitty not found")
    title = ("sandbox: " if mode != "plain" else "") + cmd
    subprocess.Popen([term, "--class", "cyber-run", "--title", title, "-e"] + argv,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True, cwd=os.path.expanduser("~"))


def fzf_pick(db):
    if not shutil.which("fzf"):
        print("cyber -f needs fzf", file=sys.stderr)
        return 1
    self_path = os.path.realpath(__file__)
    lines = "\n".join(f"{t['name']}\t{','.join(t['cats'])}\t{t['desc']}" for t in db.tools)
    p = subprocess.run(
        ["fzf", "--delimiter", "\t", "--with-nth", "1,2,3", "--tabstop", "2",
         "--height", "90%", "--layout=reverse", "--border=rounded", "--color=bw",
         "--prompt", f"{I_SEARCH} ", "--header", "Enter: put command on prompt \u00b7 Esc: cancel",
         "--preview", f"NO_COLOR= {self_path} --detail {{1}}", "--preview-window", "right,55%,wrap"],
        input=lines, capture_output=False, stdout=subprocess.PIPE, text=True)
    name = p.stdout.split("\t", 1)[0].strip()
    if name in db.by_name:
        emit_command(main_cmd(db.by_name[name]))
    return 0


