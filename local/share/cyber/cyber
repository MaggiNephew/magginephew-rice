WHEEL_UP = getattr(curses, "BUTTON4_PRESSED", 0x80000)
WHEEL_DOWN = getattr(curses, "BUTTON5_PRESSED", 0x200000)
PRESS = getattr(curses, "BUTTON1_PRESSED", 0x2)
CLICK = getattr(curses, "BUTTON1_CLICKED", 0x4)
DCLICK = getattr(curses, "BUTTON1_DOUBLE_CLICKED", 0x8)
REPORT_POS = getattr(curses, "REPORT_MOUSE_POSITION", 0x1)
DOUBLE_S = 0.4      # max seconds between presses that count as a double-click


class Browser:
    def __init__(self, scr, db):
        self.scr, self.db = scr, db
        self.focus = 0
        self.query = ""
        self.typing = False
        self.overlay = None
        self.detail_sel = 0
        self.detail_scroll = 0
        self.cat_sel = 0
        self.cat_scroll = 0
        self.tool_sel = 0
        self.tool_scroll = 0
        self.hover = None        # (pane, item_index) under the mouse
        self.last_press = None   # (time, pane, item_index) for double-click detection
        self.detail_rows = {}    # screen row -> command index, filled while drawing

    # ---- model -------------------------------------------------------------
    def cat_entries(self):
        e = []
        if self.query:
            e.append(("search", f"search: {self.query}", len(self.db.search(self.query))))
        e.append(("all", "all tools", len(self.db.tools)))
        e += [(c, c, len(self.db.by_cat[c])) for c in self.db.cats]
        return e

    def current_cat(self):
        e = self.cat_entries()
        return e[min(self.cat_sel, len(e) - 1)][0]

    def tool_list(self):
        c = self.current_cat()
        if c == "search":
            return self.db.search(self.query)
        if c == "all":
            return self.db.tools
        return self.db.by_cat[c]

    def current_tool(self):
        tl = self.tool_list()
        return tl[self.tool_sel] if tl and self.tool_sel < len(tl) else None

    def current_cmd(self):
        t = self.current_tool()
        if not t or not t["bins"]:
            return None
        return t["bins"][min(self.detail_sel, len(t["bins"]) - 1)]

    # ---- layout ------------------------------------------------------------
    def layout(self):
        h, w = self.scr.getmaxyx()
        lw = max(16, int(w * 0.22))
        mw = max(20, int(w * 0.30))
        rw = w - lw - mw
        return h, w, lw, mw, rw

    def list_h(self):
        return max(1, self.scr.getmaxyx()[0] - 2)

    def pane_at(self, x):
        _h, _w, lw, mw, _rw = self.layout()
        return 0 if x < lw else 1 if x <= lw + mw else 2

    # ---- selection / scrolling (state is stored, never recomputed in draw) --
    def select_cat(self, i):
        n = len(self.cat_entries())
        self.cat_sel = max(0, min(i, n - 1))
        self.tool_sel = self.tool_scroll = 0
        self.detail_sel = self.detail_scroll = 0
        self._follow(0)

    def select_tool(self, i):
        n = len(self.tool_list())
        self.tool_sel = max(0, min(i, n - 1)) if n else 0
        self.detail_sel = self.detail_scroll = 0
        self._follow(1)

    def _follow(self, pane):
        """Scroll a list just enough to keep its selection visible."""
        h = self.list_h()
        if pane == 0:
            sel, sc = self.cat_sel, self.cat_scroll
        else:
            sel, sc = self.tool_sel, self.tool_scroll
        if sel < sc:
            sc = sel
        elif sel >= sc + h:
            sc = sel - h + 1
        if pane == 0:
            self.cat_scroll = sc
        else:
            self.tool_scroll = sc

    def _clamp_scroll(self):
        h = self.list_h()
        self.cat_scroll = max(0, min(self.cat_scroll, len(self.cat_entries()) - h))
        self.tool_scroll = max(0, min(self.tool_scroll, len(self.tool_list()) - h))

    # ---- draw --------------------------------------------------------------
    def draw(self):
        if self.overlay is not None:
            self._draw_overlay()
            return
        h, w, lw, mw, rw = self.layout()
        self._clamp_scroll()
        self.scr.erase()
        self._titlebar(w)
        inner_y, inner_h = 1, h - 2
        hov = lambda p: self.hover[1] if self.hover and self.hover[0] == p else None

        self._pane(0, 0, inner_y, lw, inner_h, self.cat_entries(), self._cat_row,
                   self.cat_sel, self.cat_scroll, hov(0))
        self._vline(lw, inner_y, inner_h)
        self._pane(1, lw + 1, inner_y, mw, inner_h, self.tool_list(), self._tool_row,
                   self.tool_sel, self.tool_scroll, hov(1))
        self._vline(lw + mw + 1, inner_y, inner_h)
        self._detail(lw + mw + 2, inner_y, rw - 2, inner_h)
        self._statusbar(h, w)

    def _titlebar(self, w):
        s = f" {I_FOLDER} cyber — {len(self.db.tools)} tools"
        if self.query or self.typing:
            s += f"  {I_SEARCH} search: {self.query}" + ("▁" if self.typing else "")
        try:
            self.scr.addstr(0, 0, s[:w], curses.A_BOLD)
        except curses.error:
            pass

    def _vline(self, x, y, h):
        try:
            for yy in range(y, y + h):
                self.scr.addch(yy, x, curses.ACS_VLINE)
        except curses.error:
            pass

    def _pane(self, pid, x, y, w, h, items, rowfn, sel, scroll, hover_idx=None):
        for j in range(h):
            idx = scroll + j
            if idx >= len(items):
                break
            text, _ = rowfn(items[idx])
            attr = 0
            if idx == sel:
                # focused pane: solid highlight; other panes: dimmed highlight
                attr = curses.A_REVERSE if self.focus == pid else curses.A_REVERSE | curses.A_DIM
            elif idx == hover_idx:
                attr = curses.A_UNDERLINE | curses.A_BOLD
            self._row(x, y + j, w, text, attr)

    def _row(self, x, y, w, text, attr=0):
        try:
            self.scr.addstr(y, x, (" " + text)[:w].ljust(w), attr)
        except curses.error:
            pass

    def _cat_row(self, e):
        key, label, n = e
        icon = I_SEARCH if key == "search" else I_ALL if key == "all" else (
            I_OPEN if key == self.current_cat() else I_FOLDER)
        return f"{icon} {label:<12} {n:>3}", False

    def _tool_row(self, t):
        dep = "" if t["explicit"] else " ·"
        return f"{I_TOOL} {cut(t['name'], 18)}{dep}", False

    def _detail_lines(self, t, w):
        lines = []   # (text, attr, command_index or None)
        add = lambda txt="", attr=0, ci=None: lines.append((txt, attr, ci))
        add(f" {I_STAR} {stars_s(t['stars'])}   {ver_s(t['version'])}", curses.A_DIM)
        add(" " + cut("groups: " + ", ".join(t["cats"]), w - 1), curses.A_DIM)
        add()
        for ln in textwrap.wrap(t["desc"] or "(no description)", max(12, w - 2)):
            add(" " + ln)
        add()
        if t["bins"]:
            add(" COMMANDS", curses.A_BOLD)
            for i, b in enumerate(t["bins"]):
                add(" " + b, 0, i)
        elif t["paths"]:
            add(" FILES (data package)", curses.A_BOLD)
            for p in t["paths"]:
                add(" " + p)
        else:
            add(" library / data package", curses.A_DIM)
        if t["man"]:
            add()
            add(" man: " + ", ".join(t["man"]), curses.A_DIM)
        if t["url"]:
            add()
            add(" " + cut(t["url"], w - 1), curses.A_DIM)
        return lines

    def _detail(self, x, y, w, h):
        self.detail_rows = {}
        t = self.current_tool()
        if t is None or w < 4:
            return
        try:
            self.scr.addstr(y, x, (" " + t["name"])[:w].ljust(w), curses.A_BOLD | curses.A_REVERSE)
        except curses.error:
            pass
        lines = self._detail_lines(t, w)
        body_h = h - 1
        self.detail_scroll = max(0, min(self.detail_scroll, len(lines) - body_h))
        for j in range(body_h):
            idx = self.detail_scroll + j
            if idx >= len(lines):
                break
            txt, attr, ci = lines[idx]
            if ci is not None:
                self.detail_rows[y + 1 + j] = ci
                if ci == self.detail_sel and self.focus == 2:
                    attr |= curses.A_REVERSE
                elif self.hover == (2, ci):
                    attr |= curses.A_UNDERLINE | curses.A_BOLD
            try:
                self.scr.addstr(y + 1 + j, x, txt[:w], attr)
            except curses.error:
                pass

    def _statusbar(self, h, w):
        if self.typing:
            s = " type to search · Enter: show results · Esc: cancel"
        else:
            keys = [("↑↓", "move"), ("←→", "pane"), ("Enter/2×click", "open"),
                    ("/", "search"), ("u", "usage"), ("c", "copy"), ("r", "run"), ("s", "sandbox"),
                    ("o", "offline"), ("Esc", "back"), ("q", "quit")]
            s = " " + "  ".join(f"{k}:{v}" for k, v in keys)
        try:
            self.scr.addstr(h - 1, 0, s[:w - 1].ljust(w - 1), curses.A_REVERSE)
        except curses.error:
            pass

    # ---- input -------------------------------------------------------------
    def run(self):
        while True:
            self.draw()
            self.scr.refresh()
            k = self.scr.getch()
            if k == -1 or k == curses.KEY_RESIZE:
                continue
            if k == curses.KEY_MOUSE:
                self._mouse()
                continue
            self.hover = None
            if self.typing:
                self._type(k)
                continue
            if self.overlay is not None:
                self._overlay_key(k)
                continue
            if k == ord("q"):
                return
            if k == 27:                       # Esc: clear search, else go back a pane
                if self.query:
                    self.query = ""
                    self.select_cat(0)
                elif self.focus > 0:
                    self.focus -= 1
                continue
            if k == ord("/"):
                self.typing = True
                self.query = ""
                continue
            if k in (curses.KEY_UP, ord("k")):
                self._move(-1)
            elif k in (curses.KEY_DOWN, ord("j")):
                self._move(1)
            elif k == curses.KEY_PPAGE:
                self._move(-self.list_h())
            elif k == curses.KEY_NPAGE:
                self._move(self.list_h())
            elif k in (curses.KEY_LEFT, ord("h")):
                self.focus = max(0, self.focus - 1)
            elif k in (curses.KEY_RIGHT, ord("l"), ord("\t")):
                self.focus = min(2, self.focus + 1)
            elif k in (10, 13, curses.KEY_ENTER):
                self._open()
            elif k == ord("u"):
                self._usage()
            elif k == ord("c"):
                self._copy()
            elif k == ord("r"):
                self._run("plain")
            elif k == ord("s"):
                self._run("sandbox")
            elif k == ord("o"):
                self._run("offline")
            elif k in (127, curses.KEY_BACKSPACE, 8):
                self.focus = max(0, self.focus - 1)

    def _move(self, d):
        if self.focus == 0:
            self.select_cat(self.cat_sel + d)
        elif self.focus == 1:
            self.select_tool(self.tool_sel + d)
        else:
            t = self.current_tool()
            n = len(t["bins"]) if t and t["bins"] else 0
            if n:
                self.detail_sel = max(0, min(self.detail_sel + d, n - 1))
            else:
                self.detail_scroll = max(0, self.detail_scroll + d)

    def _open(self):
        if self.focus == 0:
            self.focus = 1
            self.select_tool(0)
        elif self.focus == 1:
            self.focus = 2
        else:
            self._usage()

    def _set_overlay(self, title, blocks):
        lines = []
        for sub, text in blocks:
            if sub:
                lines.append(("H", sub))
            for ln in text.splitlines():
                lines.append(("T", ln))
        self.overlay = {"title": title, "lines": lines, "scroll": 0}

    def _usage(self):
        t = self.current_tool()
        if not t:
            return
        if not t["bins"]:
            self._set_overlay(t["name"], [(None, "(data/wordlist package — no command; see FILES)")])
            return
        cmd = self.current_cmd() or t["bins"][0]
        blocks = []
        if t["man"]:
            page = t["man"][0]
            blocks.append((f"man {page}", man_text(page, self.scr.getmaxyx()[1] - 2)))
        tl = tldr_text(cmd)
        if tl:
            blocks.append((f"tldr {cmd}", tl))
        if not blocks:
            blocks.append((f"{cmd} --help", help_text(cmd)))
        self._set_overlay(t["name"], blocks)

    def _run(self, mode):
        cmd = self.current_cmd()
        if not cmd:
            t = self.current_tool()
            if t:
                self._set_overlay(t["name"], [(None, "(data/wordlist package \u2014 no command to run)")])
            return
        try:
            launch_window(cmd, mode)
        except RuntimeError as e:
            self._set_overlay("can't open " + cmd, [(None, str(e))])

    def _copy(self):
        cmd = self.current_cmd()
        if not cmd:
            return
        if shutil.which("wl-copy"):
            subprocess.run(["wl-copy"], input=cmd.encode())
            self._set_overlay("copy", [(None, f"copied to clipboard: {cmd}")])
        else:
            self._set_overlay("copy", [(None, cmd), (None, "(wl-copy not available)")])

    def _overlay_key(self, k):
        page = self.list_h()
        if k in (27, ord("q"), 10, 13, 127, curses.KEY_BACKSPACE, 8):
            self.overlay = None
        elif k in (curses.KEY_UP, ord("k")):
            self.overlay["scroll"] -= 1
        elif k in (curses.KEY_DOWN, ord("j")):
            self.overlay["scroll"] += 1
        elif k in (ord(" "), curses.KEY_NPAGE):
            self.overlay["scroll"] += page
        elif k in (ord("b"), curses.KEY_PPAGE):
            self.overlay["scroll"] -= page
        elif k == curses.KEY_HOME:
            self.overlay["scroll"] = 0
        elif k == curses.KEY_END:
            self.overlay["scroll"] = 1 << 30

    def _draw_overlay(self):
        h, w = self.scr.getmaxyx()
        self.scr.erase()
        title = self.overlay["title"]
        lines = self.overlay["lines"]
        body_h = h - 2
        self.overlay["scroll"] = max(0, min(self.overlay["scroll"], len(lines) - body_h))
        sc = self.overlay["scroll"]
        try:
            self.scr.addstr(0, 0, f" ✕ {title}   (click here, q or Esc to close)"[:w].ljust(w),
                            curses.A_BOLD | curses.A_REVERSE)
        except curses.error:
            pass
        for j in range(body_h):
            idx = sc + j
            if idx >= len(lines):
                break
            kind, txt = lines[idx]
            try:
                self.scr.addstr(1 + j, 0, txt[:w], curses.A_BOLD if kind == "H" else 0)
            except curses.error:
                pass
        end = min(len(lines), sc + body_h)
        try:
            self.scr.addstr(h - 1, 0, f" lines {sc + 1 if lines else 0}-{end} of {len(lines)}"
                            "   wheel/arrows/space to scroll"[:w - 1].ljust(w - 1), curses.A_REVERSE)
        except curses.error:
            pass

    def _type(self, k):
        if k == 27:
            self.typing = False
            self.query = ""
            self.select_cat(0)
        elif k in (10, 13, curses.KEY_ENTER):
            self.typing = False
            self.select_cat(0)               # the "search:" entry is first
            self.focus = 1 if self.query else 0
        elif k in (127, curses.KEY_BACKSPACE, 8):
            self.query = self.query[:-1]
            self.select_cat(0)
        elif 32 <= k < 127:
            self.query += chr(k)
            self.select_cat(0)

    # ---- mouse -------------------------------------------------------------
    def _item_at(self, pane, y):
        """Index of the list item / command under screen row y, or None."""
        h = self.scr.getmaxyx()[0]
        if y < 1 or y >= h - 1:
            return None
        if pane == 0:
            i, n = self.cat_scroll + y - 1, len(self.cat_entries())
        elif pane == 1:
            i, n = self.tool_scroll + y - 1, len(self.tool_list())
        else:
            return self.detail_rows.get(y)
        return i if 0 <= i < n else None

    def _mouse(self):
        try:
            _id, x, y, _z, bstate = curses.getmouse()
        except curses.error:
            return
        if self.overlay is not None:
            if bstate & WHEEL_UP:
                self.overlay["scroll"] -= 3
            elif bstate & WHEEL_DOWN:
                self.overlay["scroll"] += 3
            elif bstate & (PRESS | CLICK | DCLICK) and y == 0:
                self.overlay = None
            return
        if self.typing and bstate & (PRESS | CLICK | DCLICK):
            self.typing = False          # clicking away finishes the search box
        pane = self.pane_at(x)

        if bstate & WHEEL_UP:
            self._scroll_pane(pane, -3)
            return
        if bstate & WHEEL_DOWN:
            self._scroll_pane(pane, 3)
            return

        idx = self._item_at(pane, y)
        if not bstate & (PRESS | CLICK | DCLICK):
            # plain motion: just track hover
            self.hover = (pane, idx) if idx is not None else None
            return

        now = time.monotonic()
        double = bool(bstate & DCLICK)
        lp = self.last_press
        if lp and lp[1] == pane and lp[2] == idx and idx is not None and now - lp[0] < DOUBLE_S:
            double = True
        self.last_press = None if double else (now, pane, idx)

        if y == 0 or y == self.scr.getmaxyx()[0] - 1:
            return                        # title / status bar
        self.focus = pane
        if idx is None:
            return                        # empty space: focus the pane, select nothing
        if pane == 0:
            if idx != self.cat_sel:
                self.select_cat(idx)
            if double:
                self._open()
        elif pane == 1:
            if idx != self.tool_sel:
                self.select_tool(idx)
            if double:
                self._usage()
        else:
            self.detail_sel = idx
            if double:
                self._usage()

    def _scroll_pane(self, pane, d):
        if pane == 0:
            self.cat_scroll += d
        elif pane == 1:
            self.tool_scroll += d
        else:
            self.detail_scroll = max(0, self.detail_scroll + d)
        self._clamp_scroll()


def run_browser(db):
    # Esc normally waits ~1s for a possible escape sequence; make it instant.
    os.environ.setdefault("ESCDELAY", "25")

    def _term(seq):
        try:
            sys.stdout.flush()
            os.write(sys.stdout.fileno(), seq.encode())
        except (OSError, AttributeError, ValueError):
            pass

    def main(stdscr):
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        stdscr.keypad(1)
        try:
            curses.set_escdelay(25)
        except (AttributeError, curses.error):
            pass
        try:
            # report presses immediately; double-clicks are detected in Browser._mouse
            curses.mouseinterval(0)
            curses.mousemask(PRESS | WHEEL_UP | WHEEL_DOWN | REPORT_POS)
        except curses.error:
            pass
        # ncurses does not turn on any-motion (1003) reporting itself
        _term("\x1b[?1003h")
        try:
            Browser(stdscr, db).run()
        finally:
            _term("\x1b[?1003l")
    try:
        curses.wrapper(main)
    except KeyboardInterrupt:
        pass


