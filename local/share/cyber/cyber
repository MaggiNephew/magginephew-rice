class DB:
    def __init__(self):
        if gen.is_stale():
            try:
                gen.build()
            except Exception as e:
                print(f"cyber: could not refresh tool list ({e})", file=sys.stderr)
        with open(gen.OUT, encoding="utf-8") as f:
            tools = json.load(f)["tools"]
        self.tools = sorted(tools, key=lambda t: (-t["stars"], t["name"].lower()))
        self.by_name = {t["name"]: t for t in self.tools}
        self.by_bin = {b: t for t in self.tools for b in t["bins"]}
        self.cats = sorted({c for t in self.tools for c in t["cats"]})
        self.by_cat = {c: [t for t in self.tools if c in t["cats"]] for c in self.cats}

    def cat_num(self, cat):
        return self.cats.index(cat) + 1

    def search(self, query):
        words = query.lower().split()
        if not words:
            return []
        scored = []
        for t in self.tools:
            name = t["name"].lower()
            hay = " ".join([name, t["desc"].lower(), " ".join(t["bins"]).lower(), " ".join(t["cats"])])
            if all(w in hay for w in words):
                w0 = words[0]
                rank = 0 if name == w0 else 1 if name.startswith(w0) else 2 if w0 in name else 3
                scored.append((rank, -t["stars"], name, t))
        return [s[3] for s in sorted(scored, key=lambda s: s[:3])]


def main_cmd(t):
    if t["bins"]:
        return t["bins"][0]
    return t["paths"][0] if t["paths"] else ""


def emit_command(cmd):
    out = os.environ.get("CYBER_OUT")
    if out:
        with open(out, "w") as f:
            f.write(cmd)
    else:
        print(cmd)


def stars_s(n):
    return f"{n:,}" if n else "n/a"


def ver_s(v):
    return v.split(":", 1)[1] if ":" in v else v


def run_capture(argv, timeout=6, env=None):
    try:
        p = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, timeout=timeout, env=env)
        out = (p.stdout + p.stderr).decode("utf-8", "replace")
    except subprocess.TimeoutExpired as e:
        out = ((e.stdout or b"") + (e.stderr or b"")).decode("utf-8", "replace")
        out += f"\n[stopped after {timeout}s]"
    except FileNotFoundError:
        out = f"{argv[0]}: not found"
    out = re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", out)
    out = re.sub(r".\x08", "", out)
    return out.expandtabs(4).replace("\r", "")


def help_text(cmd):
    out = run_capture([cmd, "--help"])
    if len(out.strip().splitlines()) < 2:
        alt = run_capture([cmd, "-h"])
        if len(alt.strip()) > len(out.strip()):
            out = alt
    return out.strip() or "(no output)"


def man_text(page, width):
    env = dict(os.environ, MANPAGER="cat", PAGER="cat", MANWIDTH=str(max(40, width)))
    return run_capture(["man", page], timeout=10, env=env).strip() or "(no man page)"


def tldr_text(cmd):
    out = run_capture(["tldr", "--color", "never", cmd]).strip()
    if not out or "no tldr page" in out.lower():
        return ""
    return out


