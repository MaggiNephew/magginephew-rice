def completions(db):
    for c in db.cats:
        print(c)
    for t in db.tools:
        print(t["name"])


def main():
    locale.setlocale(locale.LC_ALL, "")
    db = DB()

    argv = sys.argv[1:]
    if not argv:
        if sys.stdout.isatty() and sys.stdin.isatty():
            run_browser(db)
        else:
            print_cats(db)
        return

    a = argv[0]

    if a in ("-h", "--help", "help"):
        print(__doc__.rstrip())
        return
    if a in ("-l", "--list", "groups"):
        print_cats(db)
        return
    if a in ("--update",):
        gen.build()
        print("rebuilt tool list")
        return
    if a in ("--completions",):
        completions(db)
        return
    if a == "--detail" and len(argv) >= 2:
        t = db.by_name.get(argv[1])
        if t:
            print_detail(db, t, with_usage=False)
        return
    if a in ("sandbox", "--sandbox", "-x"):
        rest = [x for x in argv[1:] if x != "--offline"]
        if not rest:
            sys.exit("usage: cyber sandbox <tool or command> [--offline]")
        t = db.by_name.get(rest[0]) or db.by_bin.get(rest[0])
        cmd = main_cmd(t) if t and t["bins"] else rest[0]
        try:
            av = shell_argv(cmd, "offline" if "--offline" in argv else "sandbox")
        except RuntimeError as e:
            sys.exit(f"cyber: {e}")
        os.execvp(av[0], av)
    if a in ("-f", "--fzf"):
        sys.exit(fzf_pick(db))
    if a in ("-s", "--search"):
        q = " ".join(argv[1:])
        res = db.search(q)
        print_list(db, f"search: {q}", res)
        return

    # -g<N> [M]
    m = re.match(r"^-g(\d+)$", a) or re.match(r"^g(\d+)$", a)
    if m:
        gnum = int(m.group(1))
        if gnum < 1 or gnum > len(db.cats):
            print(f"invalid group: {gnum} (1-{len(db.cats)})")
            return
        cat = db.cats[gnum - 1]
        if len(argv) >= 2 and argv[1].isdigit():
            tnum = int(argv[1])
            tools = db.by_cat[cat]
            if tnum < 1 or tnum > len(tools):
                print(f"invalid tool: {tnum} (1-{len(tools)})")
                return
            print_detail(db, tools[tnum - 1])
        else:
            print_list(db, cat, db.by_cat[cat])
        return

    # name: category or tool or binary
    if a in db.by_name:
        print_detail(db, db.by_name[a])
    elif a in db.by_cat:
        print_list(db, a, db.by_cat[a])
    elif a in db.by_bin:
        print_detail(db, db.by_bin[a])
    else:
        res = db.search(a)
        if res:
            print_list(db, f"search: {a}", res)
        else:
            print(f"no such group, tool, or command: {a}", file=sys.stderr)
            sys.exit(1)


if __name__ == "__main__":
    main()
