def width():
    return max(60, shutil.get_terminal_size((100, 24)).columns)


def cut(s, n):
    return s if len(s) <= n else s[:max(0, n - 1)] + "\u2026"


def print_cats(db):
    W = width()
    print(f"{B}CYBERSEC TOOL GROUPS{R}  {D}{len(db.tools)} tools \u00b7 {len(db.cats)} groups{R}")
    print(D + "\u2500" * W + R)
    for i, c in enumerate(db.cats, 1):
        tools = db.by_cat[c]
        head = f"{i:>3}. {c:<15} {D}{len(tools):>3} tools{R}  "
        print(head + D + cut(CATDESC.get(c, ""), W - 30) + R)
    print(D + "\u2500" * W + R)
    print(f"{D}cyber <group> \u00b7 cyber <tool> \u00b7 cyber -s <words> \u00b7 cyber -f  (or just `cyber` for the browser){R}")


def print_list(db, title, tools):
    W = width()
    print(f"{B}{title}{R}  {D}({len(tools)} tools){R}")
    print(D + "\u2500" * W + R)
    namew = min(26, max((len(t["name"]) for t in tools), default=10))
    for i, t in enumerate(tools, 1):
        dep = f"{D}\u00b7dep{R}" if not t["explicit"] else "    "
        line = f"{i:>3}. {D}{stars_s(t['stars']):>7}{R} {B}{t['name']:<{namew}}{R} {dep} "
        print(line + D + cut(t["desc"], W - namew - 20) + R)
    print(D + "\u2500" * W + R)


def print_detail(db, t, W=None, with_usage=True):
    W = W or min(width(), 90)
    print(f"{B}{t['name']}{R}  {D}{ver_s(t['version'])}{R}")
    print(D + "\u2500" * W + R)
    grp = "  ".join(f"{c} (-g{db.cat_num(c)})" for c in t["cats"])
    print(f"{D}groups {R} {grp}")
    line = f"{D}rating {R} {I_STAR} {stars_s(t['stars'])} GitHub stars"
    if not t["explicit"]:
        line += f"  {D}(installed as a dependency){R}"
    print(line)
    print()
    for line in textwrap.wrap(t["desc"] or "(no description)", W - 2):
        print("  " + line)
    print()
    if t["bins"]:
        print(f"{B}COMMANDS{R}")
        for b in t["bins"]:
            print(f"  {b}")
    elif t["paths"]:
        print(f"{B}FILES{R}  {D}(data package, no command){R}")
        for p in t["paths"]:
            print(f"  {p}")
    else:
        print(f"{D}library / data package \u2014 no command{R}")
    if t["man"]:
        print(f"\n{D}man    {R} " + ", ".join(t["man"]))
    if t["url"]:
        print(f"{D}docs   {R} {t['url']}")
    if with_usage and t["bins"]:
        cmd = t["bins"][0]
        print(f"\n{B}TRY{R}")
        tl = tldr_text(cmd)
        if tl:
            print(D + cut(tl, W * 8) + R)
        else:
            print(D + cut(help_text(cmd), W * 8) + R)


