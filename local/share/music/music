def print_list(tracks):
    if not tracks:
        say("no songs")
        return
    W = max(60, shutil.get_terminal_size((100, 24)).columns)
    for t in tracks:
        name = f"{B}{t['title']}{R} {D}· {t['artist']}{R}"
        alb = f"{D}{t['album']}{R}" if t["album"] else ""
        say(f"  {cut(name, W)}  {alb}")


def take_opts(args, names):
    """Split ["--artist", "X", "word", ...] into ({"--artist": "X"}, ["word", ...])."""
    opts, words, i = {}, [], 0
    while i < len(args):
        if args[i] in names and i + 1 < len(args):
            opts[args[i]] = args[i + 1]
            i += 2
        else:
            words.append(args[i])
            i += 1
    return opts, words


def notify(title, body, urgent=False):
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-a", "Music", "-i", "audio-x-generic"]
                       + (["-u", "critical"] if urgent else []) + [title, body],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def run_job(job_id, query, hints):
    """`music get` started by the browser button: progress goes to a status file the button
    reads, and a desktop notification says when the song is in the library."""
    os.makedirs(M.JOBS_DIR, exist_ok=True)
    path = os.path.join(M.JOBS_DIR, "".join(ch for ch in job_id if ch.isalnum() or ch in "-_") + ".json")
    state = {"state": "running", "msg": "starting…", "pct": 0, "path": "", "title": "", "updated": 0}

    def save(**kw):
        state.update(kw, updated=time.time())
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(state, f, ensure_ascii=False)
        os.replace(tmp, path)
    save()
    try:
        paths = M.download(query, log=lambda s: save(msg=s), hints=hints,
                           progress=lambda p: save(msg=f"downloading… {p}%", pct=p))
        t = M.read_tags(paths[0])
        name = (t["title"] or os.path.basename(paths[0])) + (f" — {t['artist']}" if t["artist"] else "")
        save(state="done", msg="added to your library", pct=100, path=paths[0], title=name)
        notify("Added to your library", name)
    except Exception as e:
        save(state="error", msg=str(e))
        notify("Could not add the song", str(e), urgent=True)
        sys.exit(1)


