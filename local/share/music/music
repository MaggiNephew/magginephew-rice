def setup_brave():
    """Register the native helper with Brave (and Chromium / Chrome if present)."""
    home = os.path.expanduser("~")
    cfg = os.environ.get("XDG_CONFIG_HOME") or os.path.join(home, ".config")
    helper = os.path.join(HERE, "brave-host")
    ext = os.path.join(HERE, "brave-extension")
    if not os.path.isfile(helper):
        sys.exit("music: brave-host is missing next to the music command")
    os.chmod(helper, 0o755)
    manifest = {"name": HOST_NAME, "description": "Local music library helper",
                "path": helper, "type": "stdio", "allowed_origins": [f"chrome-extension://{EXT_ID}/"]}
    browsers = [("Brave", "BraveSoftware/Brave-Browser", True), ("Chromium", "chromium", False),
                ("Chrome", "google-chrome", False)]
    done = []
    for name, sub, always in browsers:
        root = os.path.join(cfg, sub)
        if not always and not os.path.isdir(root):
            continue
        d = os.path.join(root, "NativeMessagingHosts")
        os.makedirs(d, exist_ok=True)
        with open(os.path.join(d, HOST_NAME + ".json"), "w", encoding="utf-8") as f:
            json.dump(manifest, f, indent=2)
        done.append(name)
    say(f"{B}helper registered{R} for {', '.join(done)}")
    say("")
    say(f"{B}Load the extension (once):{R}")
    say("  1. open  brave://extensions")
    say("  2. turn on  Developer mode  (top right)")
    say("  3. click  Load unpacked  and pick:")
    say(f"     {ext}")
    say("  4. pin it: puzzle-piece icon in the toolbar \u2192 pin  Local music")
    say("")
    say(f"{D}extension id {EXT_ID} \u2014 if Brave shows a different id, tell Claude.{R}")


def need_mutagen():
    if not M._mutagen():
        sys.exit("music: python-mutagen is not installed (sudo pacman -S python-mutagen)")


def main():
    locale.setlocale(locale.LC_ALL, "")
    a = sys.argv[1:]
    if not a:
        if sys.stdin.isatty() and sys.stdout.isatty():
            need_mutagen()
            return run_app()
        return say(__doc__.strip())
    cmd, rest = a[0], a[1:]
    try:
        if cmd in ("-h", "--help", "help"):
            say(__doc__.strip())
        elif cmd == "get":
            need_mutagen()
            opts, words = take_opts(rest, ("--artist", "--title", "--job"))
            if not words:
                sys.exit("usage: music get <song name or link> [--artist A] [--title T]")
            hints = {"artist": opts.get("--artist", ""), "title": opts.get("--title", "")}
            if opts.get("--job"):
                return run_job(opts["--job"], " ".join(words), hints)
            M.download(" ".join(words), log=lambda s: say(s), hints=hints,
                       progress=(lambda p: print(f"\r  downloading… {p}%", end="", flush=True)) if TTY else None)
        elif cmd == "tag":
            need_mutagen()
            artist = title = ""
            files = []
            i = 0
            while i < len(rest):
                if rest[i] == "--artist" and i + 1 < len(rest):
                    artist = rest[i + 1]; i += 2
                elif rest[i] == "--title" and i + 1 < len(rest):
                    title = rest[i + 1]; i += 2
                else:
                    files.append(rest[i]); i += 1
            if not files:
                sys.exit("usage: music tag <file...> [--artist A] [--title T]")
            for f in files:
                if os.path.isdir(f):
                    sub = sorted(os.path.join(r, x) for r, _, fs in os.walk(f) for x in fs
                                 if os.path.splitext(x)[1].lower() in M.AUDIO_EXT)
                else:
                    sub = [f]
                for s in sub:
                    say(f"{B}{os.path.basename(s)}{R}")
                    M.tag_file(s, artist, title, log=lambda m: say("  " + m))
            M.scan()
        elif cmd == "play":
            tracks = M.scan()
            if rest and os.path.isfile(" ".join(rest)):
                p = os.path.abspath(" ".join(rest))
                paths = [t["path"] for t in tracks]
                if p in paths:
                    M.play(paths, paths.index(p))
                else:
                    M.play([p])
            elif rest:
                hits = M.search(tracks, " ".join(rest))
                if not hits:
                    sys.exit("no songs match")
                M.play([t["path"] for t in hits])
            else:
                st = M.status()
                if st.get("running") and st.get("path"):
                    M.ipc("set_property", "pause", False)
                elif tracks:
                    M.play([t["path"] for t in tracks])
        elif cmd in ("add", "queue"):
            if not rest:
                sys.exit("usage: music add <file...>")
            M.enqueue(rest)
        elif cmd in ("toggle", "pause"):
            M.toggle()
        elif cmd == "next":
            M.next_track()
        elif cmd in ("prev", "previous"):
            M.prev_track()
        elif cmd == "stop":
            M.stop()
        elif cmd == "now":
            st = M.status()
            if not st.get("running") or not st.get("path"):
                return say("nothing playing")
            t = {x["path"]: x for x in M.scan()}.get(st["path"])
            name = f"{t['title']} · {t['artist']}" if t else os.path.basename(st["path"])
            say(f"{'paused' if st['paused'] else 'playing'}: {name}  ({M.fmt_time(st['pos'])} / {M.fmt_time(st['duration'])})")
        elif cmd == "list":
            js = "--json" in rest
            words = [x for x in rest if x != "--json"]
            tracks = M.search(M.scan(), " ".join(words))
            if js:
                keep = ("path", "title", "artist", "album", "duration", "mtime", "cover")
                print(json.dumps([{k: t[k] for k in keep} for t in tracks], ensure_ascii=False))
            else:
                print_list(tracks)
        elif cmd == "scan":
            say(f"{len(M.scan(force=True))} songs in {M.MUSIC_DIR.replace(os.path.expanduser('~'), '~')}")
        elif cmd == "setup-brave":
            setup_brave()
        elif cmd == "daemon":
            M.start_player()
        else:
            sys.exit(f"music: unknown command {cmd!r} (music --help)")
    except M.PlayerError as e:
        sys.exit(f"music: {e}")
    except FileNotFoundError as e:
        sys.exit(f"music: no such file: {e}")
    except Exception as e:
        sys.exit(f"music: {e}")


if __name__ == "__main__":
    main()
