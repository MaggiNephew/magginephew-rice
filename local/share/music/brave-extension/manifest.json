{
  "manifest_version": 3,
  "name": "Local music",
  "version": "1.0",
  "description": "Add the YouTube / YouTube Music song you are on to your local music library (only that song, even inside a playlist).",
  "key": "",
  "action": {
    "default_title": "Add to local library",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "nativeMessaging", "storage", "contextMenus"]
}
