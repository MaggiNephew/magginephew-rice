#!/usr/bin/env bash
# shade — switch kitty background shaders (called by the `Shade` function in ~/shade.sh)
#
# Shaders live in ~/Documents/shaders/ (kitty custom shader format):
#   foo.slang                 background shader — automatically wrapped with text
#                             bubbles (tune in ~/.config/kitty/shaders/bubbles.slang)
#   foo.slang + foo.pipeline  custom pipeline, used as-is (no bubbles)
#
#   Shade              list available shaders (numbered, * = current)
#   Shade <N|name>     use that shader as the background (persists across restarts)
#   Shade off          disable the background shader
#
# The choice is written to ~/.config/kitty/shader.conf, which kitty.conf includes.

SHADE_DIR="$HOME/Documents/shaders"
SHADE_KITTY="$HOME/.config/kitty/shaders"
SHADE_CONF="$HOME/.config/kitty/shader.conf"
SHADE_STATE="$HOME/.config/kitty/shade-state"

_shade_reload() {
    # reload every running kitty so all windows match
    [[ -n ${SHADE_NO_RELOAD:-} ]] || pkill -USR1 -x kitty 2>/dev/null
}

_shade_names() {
    local f
    SHADE_NAMES=()
    for f in "$SHADE_DIR"/*.slang "$SHADE_DIR"/*.pipeline; do
        [[ -e "$f" ]] || continue
        f=$(basename "$f"); f=${f%.*}
        [[ " ${SHADE_NAMES[*]} " == *" $f "* ]] || SHADE_NAMES+=("$f")
    done
    (( ${#SHADE_NAMES[@]} )) && mapfile -t SHADE_NAMES < <(printf '%s\n' "${SHADE_NAMES[@]}" | sort)
}

_shade_list() {
    _shade_names
    if [[ ${#SHADE_NAMES[@]} -eq 0 ]]; then
        echo "No shaders in $SHADE_DIR (add .slang files there)"
        return 1
    fi
    local cur="" i=1 base mark
    [[ -f "$SHADE_STATE" ]] && cur=$(<"$SHADE_STATE")
    echo "Available background shaders:"
    for base in "${SHADE_NAMES[@]}"; do
        mark=" "
        [[ "$base" == "$cur" ]] && mark="*"
        printf "  %s%2d) %s\n" "$mark" "$i" "$base"
        i=$((i + 1))
    done
    echo
    echo "Usage: Shade <number|name> | Shade off"
}

Shade() {
    mkdir -p "$SHADE_DIR" "$SHADE_KITTY"

    local arg="${1:-}" base=""
    case "$arg" in
        ""|ops|list|help)
            _shade_list
            return
            ;;
        off)
            rm -f "$SHADE_STATE" "$SHADE_KITTY/active.slang" "$SHADE_KITTY/active.pipeline"
            printf '# managed by Shade (~/shade.sh) — background shader off\n' > "$SHADE_CONF"
            echo "Background shader disabled"
            _shade_reload
            return
            ;;
    esac

    _shade_names
    if [[ "$arg" =~ ^[0-9]+$ ]]; then
        if [[ $arg -lt 1 || $arg -gt ${#SHADE_NAMES[@]} ]]; then
            echo "Invalid number: $arg (1..${#SHADE_NAMES[@]})"
            return 1
        fi
        base="${SHADE_NAMES[$((arg - 1))]}"
    elif [[ " ${SHADE_NAMES[*]} " == *" $arg "* ]]; then
        base="$arg"
    else
        echo "Unknown shader: $arg"
        echo "Usage: Shade <number|name> | Shade off"
        return 1
    fi

    local target
    if [[ -f "$SHADE_DIR/$base.pipeline" ]]; then
        # custom pipeline: point kitty straight at it; its shaders load from the same dir
        rm -f "$SHADE_KITTY/active.slang" "$SHADE_KITTY/active.pipeline"
        target="$SHADE_DIR/$base.pipeline"
    else
        # plain shader: wrap it with text bubbles (see ~/.config/kitty/shaders/bubbles.slang)
        ln -sf "$SHADE_DIR/$base.slang" "$SHADE_KITTY/active.slang"
        cat > "$SHADE_KITTY/active.pipeline" <<'EOF'
# generated by Shade — background shader wrapped with text bubbles
textures a b

# text-distance mask (horizontal, then vertical)
startgroup
    var int STAGE = 0
    shaders bubbles
    output_texture a
endgroup
startgroup
    var int STAGE = 1
    shaders bubbles
    output_texture b
endgroup

# the background shader itself
startgroup
    shaders active
    output_texture a
endgroup

# composite: shader outside bubbles, bubbles behind text
startgroup
    var int STAGE = 2
    shaders bubbles
endgroup
EOF
        target="active"
    fi
    printf '# managed by Shade (~/shade.sh)\ncustom_shaders %s\n' "$target" > "$SHADE_CONF"
    printf '%s\n' "$base" > "$SHADE_STATE"
    echo "Background set to: $base"
    _shade_reload
}

Shade "$@"
