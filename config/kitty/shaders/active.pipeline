# generated by Shade — background shader wrapped with text bubbles
textures a b

# text-distance mask (horizontal, then vertical)
startgroup
    var int STAGE = 0
    shaders bubbles
    output_texture a
endgroup
startgroup
    var int STAGE = 1
    shaders bubbles
    output_texture b
endgroup

# the background shader itself
startgroup
    shaders active
    output_texture a
endgroup

# composite: shader outside bubbles, bubbles behind text
startgroup
    var int STAGE = 2
    shaders bubbles
endgroup
